{
  "kind": "collectionType",
  "collectionName": "cushion_types",
  "info": {
    "singularName": "cushion-type",
    "pluralName": "cushion-types",
    "displayName": "Cushion Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "types": {
      "type": "enumeration",
      "enum": [
        "square",
        "rectangular",
        "round",
        "oval"
      ]
    },
    "width_cm": {
      "type": "integer",
      "required": true,
      "description": "Width of the cushion in cm"
    },
    "height_cm": {
      "type": "integer",
      "required": true,
      "description": "Height of the cushion in cm"
    }
  }
}
