{
  "kind": "collectionType",
  "collectionName": "lining_colours",
  "info": {
    "singularName": "lining-colour",
    "pluralName": "lining-colours",
    "displayName": "Lining Colour / Finish"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "key": { "type": "string", "required": true, "unique": true },
    "display_name": { "type": "string", "required": true },
    "hex": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    },
    "active": { "type": "boolean", "default": true },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    },
    "applies_to_curtains": { "type": "boolean", "default": true },
    "applies_to_blinds": { "type": "boolean", "default": true },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "compatible_lining_types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::lining.lining",
      "inversedBy": "lining_colour_options"
    }
  }
}
