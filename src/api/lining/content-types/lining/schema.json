{
  "kind": "collectionType",
  "collectionName": "linings",
  "info": {
    "singularName": "lining",
    "pluralName": "linings",
    "displayName": "Lining"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "liningType": {
      "type": "string",
      "required": true
    },
    "price_per_metre": {
      "type": "decimal",
      "required": false
    },
    "colour": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    },
    "key": { "type": "string", "unique": true },
    "display_name": { "type": "string" },
    "active": { "type": "boolean", "default": true },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    },
    "is_configurator_option": { "type": "boolean", "default": false },
    "applies_to_curtains": { "type": "boolean", "default": true },
    "applies_to_blinds": { "type": "boolean", "default": true },
    "lining_colour_options": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::lining-colour.lining-colour",
      "mappedBy": "compatible_lining_types"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "pricing_rule": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::pricing-rule.pricing-rule"
    }
  }
}
