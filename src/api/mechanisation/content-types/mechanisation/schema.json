{
  "kind": "collectionType",
  "collectionName": "mechanisations",
  "info": {
    "singularName": "mechanisation",
    "pluralName": "mechanisations",
    "displayName": "Mechanisation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "key": {
      "type": "string",
      "unique": true
    },
    "display_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "mechanism_family": {
      "type": "string"
    },
    "mechanism_finishes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::mechanism-finish.mechanism-finish",
      "inversedBy": "compatible_mechanisations"
    }
  }
}
